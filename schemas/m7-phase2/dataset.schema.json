{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:campusloop:m7:phase2:dataset:v1",
  "$defs": {
    "rawProduct": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "m7-raw-v1"
        },
        "recordId": {
          "type": "string",
          "minLength": 1
        },
        "sourceProduct": {
          "type": "object",
          "properties": {
            "id": {
              "type": "integer",
              "minimum": 1
            },
            "seller": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "id"
              ],
              "additionalProperties": false
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string"
            },
            "category": {
              "type": "string",
              "minLength": 1
            },
            "price": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,7})(\\.[0-9]{1,2})?$"
            },
            "condition": {
              "anyOf": [
                {
                  "enum": [
                    "全新",
                    "九成新",
                    "八成新",
                    "七成新",
                    "六成新及以下"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "campusLocation": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "enum": [
                "ON_SALE",
                "RESERVED",
                "SOLD",
                "HIDDEN"
              ]
            },
            "createdAt": {
              "type": "string",
              "format": "date-time"
            },
            "updatedAt": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "id",
            "seller",
            "title",
            "description",
            "category",
            "price",
            "condition",
            "campusLocation",
            "status",
            "createdAt",
            "updatedAt"
          ],
          "additionalProperties": false
        },
        "research": {
          "type": "object",
          "properties": {
            "catalogId": {
              "type": "string",
              "minLength": 1
            },
            "entityId": {
              "type": "string",
              "minLength": 1
            },
            "nearDuplicateGroup": {
              "type": "string",
              "minLength": 1
            },
            "categoryId": {
              "type": "string",
              "minLength": 1
            },
            "campusId": {
              "type": "string",
              "minLength": 1
            },
            "placeIds": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "visibility": {
              "enum": [
                "public",
                "campus",
                "private"
              ]
            },
            "deleted": {
              "type": "boolean"
            },
            "entityVersion": {
              "type": "integer",
              "minimum": 1
            },
            "attributes": {
              "type": "object",
              "properties": {
                "model": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "model"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "catalogId",
            "entityId",
            "nearDuplicateGroup",
            "categoryId",
            "campusId",
            "placeIds",
            "visibility",
            "deleted",
            "entityVersion",
            "attributes"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schemaVersion",
        "recordId",
        "sourceProduct",
        "research"
      ],
      "additionalProperties": false
    },
    "rawRequest": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "m7-raw-v1"
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "catalogId": {
          "type": "string",
          "minLength": 1
        },
        "task": {
          "enum": [
            "search",
            "matching"
          ]
        },
        "templateGroup": {
          "type": "string",
          "minLength": 1
        },
        "queryText": {
          "type": "string"
        },
        "filters": {
          "type": "object",
          "properties": {
            "categoryId": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "minCondition": {
              "anyOf": [
                {
                  "enum": [
                    "全新",
                    "九成新",
                    "八成新",
                    "七成新",
                    "六成新及以下"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "requiredPlaceIds": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "requiredModel": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "minPriceYuan": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]{0,7})(\\.[0-9]{1,2})?$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "maxPriceYuan": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]{0,7})(\\.[0-9]{1,2})?$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "categoryId",
            "minCondition",
            "requiredPlaceIds",
            "requiredModel",
            "minPriceYuan",
            "maxPriceYuan"
          ],
          "additionalProperties": false
        },
        "context": {
          "type": "object",
          "properties": {
            "viewerId": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[1-9][0-9]*$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "campusId": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "asOf": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "viewerId",
            "campusId",
            "asOf"
          ],
          "additionalProperties": false
        },
        "wanted": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "wantedId": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]*$"
                },
                "ownerId": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]*$"
                },
                "entityVersion": {
                  "type": "integer",
                  "minimum": 1
                },
                "status": {
                  "enum": [
                    "OPEN",
                    "MATCHED",
                    "CLOSED",
                    "EXPIRED"
                  ]
                },
                "expiresAt": {
                  "type": "string",
                  "format": "date-time"
                }
              },
              "required": [
                "wantedId",
                "ownerId",
                "entityVersion",
                "status",
                "expiresAt"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schemaVersion",
        "requestId",
        "catalogId",
        "task",
        "templateGroup",
        "queryText",
        "filters",
        "context",
        "wanted"
      ],
      "additionalProperties": false
    },
    "product": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "m7-processed-v1"
        },
        "productId": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "ownerId": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "catalogId": {
          "type": "string",
          "minLength": 1
        },
        "entityId": {
          "type": "string",
          "minLength": 1
        },
        "nearDuplicateGroup": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "categoryId": {
          "type": "string",
          "minLength": 1
        },
        "priceFen": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9999999999
        },
        "condition": {
          "anyOf": [
            {
              "enum": [
                "new",
                "like_new",
                "good",
                "fair",
                "poor"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "campusId": {
          "type": "string",
          "minLength": 1
        },
        "placeIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "visibility": {
          "enum": [
            "public",
            "campus",
            "private"
          ]
        },
        "deleted": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "ON_SALE",
            "RESERVED",
            "SOLD",
            "HIDDEN"
          ]
        },
        "entityVersion": {
          "type": "integer",
          "minimum": 1
        },
        "publishedAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "attributes": {
          "type": "object",
          "properties": {
            "model": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "model"
          ],
          "additionalProperties": false
        },
        "sourceRecordId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "schemaVersion",
        "productId",
        "ownerId",
        "catalogId",
        "entityId",
        "nearDuplicateGroup",
        "title",
        "description",
        "categoryId",
        "priceFen",
        "condition",
        "campusId",
        "placeIds",
        "visibility",
        "deleted",
        "status",
        "entityVersion",
        "publishedAt",
        "updatedAt",
        "attributes",
        "sourceRecordId"
      ],
      "additionalProperties": false
    },
    "request": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "m7-processed-v1"
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "catalogId": {
          "type": "string",
          "minLength": 1
        },
        "task": {
          "enum": [
            "search",
            "matching"
          ]
        },
        "templateGroup": {
          "type": "string",
          "minLength": 1
        },
        "queryText": {
          "type": "string"
        },
        "filters": {
          "type": "object",
          "properties": {
            "categoryId": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "minPriceFen": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9999999999
                },
                {
                  "type": "null"
                }
              ]
            },
            "maxPriceFen": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9999999999
                },
                {
                  "type": "null"
                }
              ]
            },
            "minCondition": {
              "anyOf": [
                {
                  "enum": [
                    "new",
                    "like_new",
                    "good",
                    "fair",
                    "poor"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "requiredPlaceIds": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "requiredModel": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "categoryId",
            "minPriceFen",
            "maxPriceFen",
            "minCondition",
            "requiredPlaceIds",
            "requiredModel"
          ],
          "additionalProperties": false
        },
        "context": {
          "type": "object",
          "properties": {
            "viewerId": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[1-9][0-9]*$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "campusId": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "asOf": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "viewerId",
            "campusId",
            "asOf"
          ],
          "additionalProperties": false
        },
        "wanted": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "wantedId": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]*$"
                },
                "ownerId": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]*$"
                },
                "entityVersion": {
                  "type": "integer",
                  "minimum": 1
                },
                "status": {
                  "enum": [
                    "OPEN",
                    "MATCHED",
                    "CLOSED",
                    "EXPIRED"
                  ]
                },
                "expiresAt": {
                  "type": "string",
                  "format": "date-time"
                }
              },
              "required": [
                "wantedId",
                "ownerId",
                "entityVersion",
                "status",
                "expiresAt"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schemaVersion",
        "requestId",
        "catalogId",
        "task",
        "templateGroup",
        "queryText",
        "filters",
        "context",
        "wanted"
      ],
      "additionalProperties": false
    },
    "semanticDraft": {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "productId": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "semanticLabel": {
          "enum": [
            0,
            1,
            2
          ]
        },
        "semanticReason": {
          "type": "string",
          "minLength": 1
        },
        "author": {
          "const": "assistant:synthetic-draft"
        },
        "reviewer": {
          "type": "null"
        },
        "reviewStatus": {
          "const": "pending_human_review"
        }
      },
      "required": [
        "requestId",
        "productId",
        "semanticLabel",
        "semanticReason",
        "author",
        "reviewer",
        "reviewStatus"
      ],
      "additionalProperties": false
    },
    "label": {
      "type": "object",
      "properties": {
        "labelId": {
          "type": "string",
          "minLength": 1
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "productId": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "catalogId": {
          "type": "string",
          "minLength": 1
        },
        "labelVersion": {
          "const": "m7-label-draft-v1"
        },
        "semanticLabel": {
          "enum": [
            0,
            1,
            2
          ]
        },
        "label": {
          "enum": [
            0,
            1,
            2,
            "U"
          ]
        },
        "eligibility": {
          "enum": [
            "eligible",
            "ineligible",
            "needs_info"
          ]
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "outcome": {
                "enum": [
                  "pass",
                  "fail",
                  "unknown",
                  "not_applicable"
                ]
              },
              "observed": {},
              "required": {}
            },
            "required": [
              "code",
              "outcome",
              "observed",
              "required"
            ],
            "additionalProperties": false
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "author": {
          "const": "assistant:synthetic-draft"
        },
        "reviewer": {
          "type": "null"
        },
        "adjudicator": {
          "type": "null"
        },
        "reviewStatus": {
          "const": "pending_human_review"
        }
      },
      "required": [
        "labelId",
        "requestId",
        "productId",
        "catalogId",
        "labelVersion",
        "semanticLabel",
        "label",
        "eligibility",
        "constraints",
        "reason",
        "author",
        "reviewer",
        "adjudicator",
        "reviewStatus"
      ],
      "additionalProperties": false
    }
  }
}
