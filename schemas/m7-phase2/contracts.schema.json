{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://campusloop.example.invalid/schemas/m7-contracts-candidate-v1",
  "$defs": {
    "PublicUser": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "nickname": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "avatar": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "id",
        "nickname"
      ],
      "additionalProperties": false
    },
    "Product": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "seller": {
          "$ref": "#/$defs/PublicUser"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "condition": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "price": {
          "type": "number",
          "minimum": 0
        },
        "originalPrice": {
          "type": "number",
          "minimum": 0
        },
        "description": {
          "type": "string",
          "maxLength": 3000
        },
        "campusLocation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "images": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          },
          "maxItems": 5
        },
        "status": {
          "const": "ON_SALE"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "seller",
        "title",
        "category",
        "condition",
        "price",
        "images",
        "status",
        "createdAt",
        "updatedAt"
      ],
      "additionalProperties": false
    },
    "Pagination": {
      "type": "object",
      "properties": {
        "page": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "pageSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "page",
        "pageSize",
        "total"
      ],
      "additionalProperties": false
    },
    "Reason": {
      "type": "object",
      "properties": {
        "code": {
          "enum": [
            "TEXT_MATCH",
            "BUDGET_MATCH",
            "CONDITION_MATCH",
            "CATEGORY_MATCH",
            "LOCATION_MATCH"
          ]
        },
        "kind": {
          "enum": [
            "factor",
            "constraint"
          ]
        },
        "field": {
          "enum": [
            "text",
            "priceFen",
            "conditionRank",
            "categoryId",
            "placeIds"
          ]
        },
        "observed": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "maxItems": 20
            }
          ]
        },
        "required": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "maxItems": 20
            },
            {
              "type": "object",
              "properties": {
                "min": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "max": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "min",
                "max"
              ],
              "additionalProperties": false
            }
          ]
        },
        "contribution": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "ruleVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "code",
        "kind",
        "field",
        "observed",
        "required",
        "contribution",
        "ruleVersion"
      ],
      "additionalProperties": false
    },
    "SearchRequest": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "mode": {
          "enum": [
            "keyword",
            "semantic",
            "hybrid"
          ]
        },
        "page": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "pageSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "minPriceFen": {
          "type": "integer",
          "minimum": 0
        },
        "maxPriceFen": {
          "type": "integer",
          "minimum": 0
        },
        "minConditionRank": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "placeIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true
        },
        "sort": {
          "enum": [
            "relevance",
            "newest",
            "price_asc",
            "price_desc"
          ]
        },
        "snapshotVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "query",
        "mode",
        "page",
        "pageSize",
        "sort"
      ],
      "additionalProperties": false
    },
    "MatchRequest": {
      "type": "object",
      "properties": {
        "wantedId": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "page": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "pageSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "snapshotVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "wantedId",
        "page",
        "pageSize"
      ],
      "additionalProperties": false
    },
    "SearchExplanation": {
      "type": "object",
      "properties": {
        "productId": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "relevanceScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "minItems": 1
        },
        "explanationDetails": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Reason"
          },
          "minItems": 1
        }
      },
      "required": [
        "productId",
        "relevanceScore",
        "reasons",
        "explanationDetails"
      ],
      "additionalProperties": false
    },
    "SearchData": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "m7-service-candidate-v1"
        },
        "ruleVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "tokenizerVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "dictionaryVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "modelVersion": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "indexVersion": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "policyGeneration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "snapshotVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "resultVersion": {
          "type": "string",
          "pattern": "^[a-z]+_[0-9a-f]{64}$"
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "degraded": {
          "type": "boolean"
        },
        "degradationReason": {
          "anyOf": [
            {
              "enum": [
                "MODEL_TIMEOUT",
                "MODEL_ERROR",
                "INDEX_NOT_READY",
                "INDEX_VERSION_MISMATCH",
                "MODEL_DISABLED"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Product"
          },
          "maxItems": 100
        },
        "requestedMode": {
          "enum": [
            "keyword",
            "semantic",
            "hybrid"
          ]
        },
        "mode": {
          "enum": [
            "keyword",
            "semantic",
            "hybrid"
          ]
        },
        "pagination": {
          "$ref": "#/$defs/Pagination"
        },
        "explanations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SearchExplanation"
          },
          "maxItems": 100
        }
      },
      "required": [
        "schemaVersion",
        "ruleVersion",
        "tokenizerVersion",
        "dictionaryVersion",
        "modelVersion",
        "indexVersion",
        "policyGeneration",
        "snapshotVersion",
        "resultVersion",
        "generatedAt",
        "expiresAt",
        "degraded",
        "degradationReason",
        "items",
        "requestedMode",
        "mode",
        "pagination",
        "explanations"
      ],
      "additionalProperties": false
    },
    "MatchItem": {
      "type": "object",
      "properties": {
        "product": {
          "$ref": "#/$defs/Product"
        },
        "productVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "wantedVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "relevanceScore": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "scoreType": {
          "enum": [
            "rule_match_v0",
            "constraints_only",
            "semantic_match"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "minItems": 1
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "explanationDetails": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Reason"
          }
        },
        "resultVersion": {
          "type": "string",
          "pattern": "^[a-z]+_[0-9a-f]{64}$"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "product",
        "productVersion",
        "wantedVersion",
        "relevanceScore",
        "scoreType",
        "reasons",
        "constraints",
        "explanationDetails",
        "resultVersion",
        "expiresAt"
      ],
      "additionalProperties": false
    },
    "MatchData": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "m7-service-candidate-v1"
        },
        "ruleVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "tokenizerVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "dictionaryVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "modelVersion": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "indexVersion": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "policyGeneration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "snapshotVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "resultVersion": {
          "type": "string",
          "pattern": "^[a-z]+_[0-9a-f]{64}$"
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "degraded": {
          "type": "boolean"
        },
        "degradationReason": {
          "anyOf": [
            {
              "enum": [
                "MODEL_TIMEOUT",
                "MODEL_ERROR",
                "INDEX_NOT_READY",
                "INDEX_VERSION_MISMATCH",
                "MODEL_DISABLED"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "wantedId": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "wantedVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "requestedMethod": {
          "enum": [
            "rule",
            "semantic"
          ]
        },
        "method": {
          "enum": [
            "rule",
            "semantic"
          ]
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MatchItem"
          },
          "maxItems": 100
        },
        "pagination": {
          "$ref": "#/$defs/Pagination"
        }
      },
      "required": [
        "schemaVersion",
        "ruleVersion",
        "tokenizerVersion",
        "dictionaryVersion",
        "modelVersion",
        "indexVersion",
        "policyGeneration",
        "snapshotVersion",
        "resultVersion",
        "generatedAt",
        "expiresAt",
        "degraded",
        "degradationReason",
        "wantedId",
        "wantedVersion",
        "requestedMethod",
        "method",
        "items",
        "pagination"
      ],
      "additionalProperties": false
    },
    "SearchSuccess": {
      "type": "object",
      "properties": {
        "code": {
          "const": 0
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "data": {
          "$ref": "#/$defs/SearchData"
        }
      },
      "required": [
        "code",
        "message",
        "data"
      ],
      "additionalProperties": false
    },
    "MatchSuccess": {
      "type": "object",
      "properties": {
        "code": {
          "const": 0
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "data": {
          "$ref": "#/$defs/MatchData"
        }
      },
      "required": [
        "code",
        "message",
        "data"
      ],
      "additionalProperties": false
    },
    "Error": {
      "type": "object",
      "properties": {
        "code": {
          "enum": [
            "VALIDATION_ERROR",
            "UNAUTHENTICATED",
            "FORBIDDEN",
            "NOT_FOUND",
            "SNAPSHOT_STALE",
            "WANTED_INACTIVE",
            "DEPENDENCY_UNAVAILABLE",
            "BASELINE_UNAVAILABLE",
            "RATE_LIMITED"
