        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "details": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              },
              "required": [],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "code",
        "message",
        "requestId",
        "details"
      ],
      "additionalProperties": false
    },
    "Pending": {
      "type": "object",
      "properties": {
        "code": {
          "const": 0
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "data": {
          "type": "object",
          "properties": {
            "state": {
              "const": "pending"
            },
            "wantedId": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "wantedVersion": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "retryAfterSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60
            }
          },
          "required": [
            "state",
            "wantedId",
            "wantedVersion",
            "retryAfterSeconds"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "code",
        "message",
        "data"
      ],
      "additionalProperties": false
    },
    "InputVersion": {
      "type": "object",
      "properties": {
        "wantedId": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "wantedVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "catalogRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "authorizationRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "policyGeneration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "refreshGeneration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "asOf": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "wantedId",
        "wantedVersion",
        "catalogRevision",
        "authorizationRevision",
        "policyGeneration",
        "refreshGeneration",
        "asOf"
      ],
      "additionalProperties": false
    },
    "Event": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "m7-event-candidate-v1"
        },
        "eventId": {
          "type": "string",
          "format": "uuid"
        },
        "entityType": {
          "enum": [
            "product",
            "wanted",
            "authorization",
            "policy",
            "refresh"
          ]
        },
        "entityId": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "entityVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "eventType": {
          "enum": [
            "PRODUCT_CHANGED",
            "WANTED_CHANGED",
            "AUTHORIZATION_CHANGED",
            "POLICY_CHANGED",
            "REFRESH_DUE"
          ]
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "catalogRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "authorizationRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "policyGeneration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "refreshGeneration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "schemaVersion",
        "eventId",
        "entityType",
        "entityId",
        "entityVersion",
        "eventType",
        "occurredAt",
        "catalogRevision",
        "authorizationRevision",
        "policyGeneration",
        "refreshGeneration"
      ],
      "additionalProperties": false
    },
    "Task": {
      "type": "object",
      "properties": {
        "taskKey": {
          "type": "string",
          "pattern": "^[a-z]+_[0-9a-f]{64}$"
        },
        "input": {
          "$ref": "#/$defs/InputVersion"
        },
        "status": {
          "enum": [
            "pending",
            "running",
            "succeeded",
            "retry_wait",
            "dead",
            "superseded"
