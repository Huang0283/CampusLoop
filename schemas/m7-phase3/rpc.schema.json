{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:campusloop:m7:baseline:rpc:v1",
  "title": "M7 private candidate RPC; not a public business DTO",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "products", "request", "dictionary"],
  "properties": {
    "schemaVersion": {"const": "m7-baseline-rpc-v1"},
    "products": {"type": "array", "maxItems": 5000, "description": "Each row is validated against the registered Phase 2 processed product schema by the engine; invalid rows are quarantined."},
    "request": {"$ref": "urn:campusloop:m7:processed:v1#/$defs/request"},
    "dictionary": {},
    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {"enum": ["keyword", "semantic"]},
        "sort": {"enum": ["relevance", "newest", "price_asc", "price_desc"]},
        "size": {"type": "integer", "minimum": 1, "maximum": 100},
        "snapshotVersion": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
        "scanPosition": {"type": "integer", "minimum": 0}
      }
    }
  }
}
