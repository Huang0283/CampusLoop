{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://campusloop.local/schemas/m8-phase2/price-dataset.schema.json",
  "title": "CampusLoop M8 Phase 2 price sample",
  "type": "object",
  "additionalProperties": false,
  "required": ["sampleId", "schemaVersion", "sourceId", "sourceType", "licenseStatus", "labelLevel", "category", "brand", "model", "condition", "originalPriceFen", "listingPriceFen", "acceptedOfferPriceFen", "transactionPriceFen", "purchaseAgeMonths", "accessoryState", "defectTags", "listedAt", "completedAt", "extractedAt", "expectedStatus"],
  "properties": {
    "sampleId": {"type": "string", "pattern": "^m8-[a-z0-9-]+$"},
    "schemaVersion": {"const": "m8-price-raw-v1"},
    "sourceId": {"type": "string", "minLength": 1},
    "sourceType": {"enum": ["synthetic", "internal_listing", "completed_order", "approved_public"]},
    "licenseStatus": {"enum": ["approved", "restricted", "unknown"]},
    "labelLevel": {"enum": ["L0_SYNTHETIC", "L1_LISTING", "L2_ACCEPTED_OFFER", "L3_COMPLETED_TRANSACTION"]},
    "category": {"enum": ["digital", "books", "household", "clothing", "sports", "other"]},
    "brand": {"type": ["string", "null"]},
    "model": {"type": ["string", "null"]},
    "condition": {"enum": ["new", "like_new", "good", "fair"]},
    "originalPriceFen": {"type": ["integer", "null"], "minimum": 1, "maximum": 9999999999},
    "listingPriceFen": {"type": ["integer", "null"], "minimum": 1, "maximum": 9999999999},
    "acceptedOfferPriceFen": {"type": ["integer", "null"], "minimum": 1, "maximum": 9999999999},
    "transactionPriceFen": {"type": ["integer", "null"], "minimum": 1, "maximum": 9999999999},
    "purchaseAgeMonths": {"type": ["integer", "null"], "minimum": 0, "maximum": 600},
    "accessoryState": {"enum": ["complete", "partial", "unknown"]},
    "defectTags": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "listedAt": {"type": "string", "format": "date-time"},
    "completedAt": {"type": ["string", "null"], "format": "date-time"},
    "extractedAt": {"type": "string", "format": "date-time"},
    "expectedStatus": {"enum": ["AVAILABLE", "LOW_CONFIDENCE", "INSUFFICIENT_DATA", "INVALID_INPUT"]}
  }
}
