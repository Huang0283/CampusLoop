  "fallbackReasons": [
    "CANDIDATE_DISABLED",
    "DATA_OR_APPROVAL_GATE_NO_GO",
    "CANDIDATE_MODEL_MISSING",
    "CANDIDATE_TIMEOUT",
    "CANDIDATE_ERROR",
    "CANDIDATE_NO_RESULT",
    "CANDIDATE_LOW_CONFIDENCE",
    "CANDIDATE_VERSION_MISMATCH",
    "CANDIDATE_INVALID_RESULT"
  ],
  "rollback": "Set candidate_enabled=false; the router returns the unchanged Phase 3 rule output.",
  "businessWritesAllowed": false,
  "riskEnforcementAllowed": false
