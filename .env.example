# ============================================================
# CampusLoop 环境变量模板（BP2-06/BP2-09，M9 维护）
# 使用：cp .env.example .env  然后按需修改；.env 已被 git 忽略
# 规则：本文件只放占位默认值，绝不放真实密钥（M10 会复查）
# ============================================================

# ---- application ----
APP_ENV=dev
LOG_LEVEL=INFO
LOG_JSON=true
CORS_ORIGINS=http://localhost:5173

# Generate local secrets: python backend/scripts/init_local.py (never committed).
AUTH_SIGNING_KEY=
AUTH_SIGNING_KID=primary
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=604800
AUTH_COOKIE_NAME=campusloop-session
# false is allowed only for local HTTP; production forces Secure/__Host-.
AUTH_COOKIE_SECURE=false
AUTH_REGISTRATION_DOMAINS=example.com,example.invalid
BASELINE_RPC_TOKEN=
BASELINE_SERVICES_ENABLED=true
# Approved first-pair-v1: wanted owner only, one notice per eligible wanted/product pair.
MATCHING_NOTIFICATIONS_ENABLED=true
M7_SERVICE_URL=http://127.0.0.1:8787
M8_SERVICE_URL=http://127.0.0.1:8788

# ---- database：PostgreSQL 16 + pgvector（docker-compose 服务 db）----
DATABASE_URL=postgresql+psycopg://campusloop:campusloop@localhost:5432/campusloop
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_CONNECT_TIMEOUT_SECONDS=3

# ---- redis（会话撤销缓存 / 未读数 / 限流；不可用时基础交易降级可用）----
REDIS_URL=redis://localhost:6379/0
REDIS_SOCKET_TIMEOUT_SECONDS=1.5

# ---- MinIO 对象存储（S3 协议；双桶权限隔离）----
MINIO_ENDPOINT=localhost:9000
# Local defaults only; use deployment secrets in production.
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
# 公共桶：商品图片等可公开内容，匿名可读（URL 直接拼接）
MINIO_PUBLIC_BUCKET=campusloop-public
# 私有桶：聊天图片/举报证据，禁止匿名访问，API 鉴权后流式返回
MINIO_PRIVATE_BUCKET=campusloop-private
MINIO_SECURE=false
S3_PUBLIC_BASE_URL=http://localhost:9000/campusloop-public

# ---- 前端（Vite 使用，BP2-09 一并维护）----
VITE_API_BASE_URL=http://localhost:8001
# Phase 3 live pages derive /ws from VITE_API_BASE_URL; legacy prototypes alone use this setting.
VITE_WS_URL=
