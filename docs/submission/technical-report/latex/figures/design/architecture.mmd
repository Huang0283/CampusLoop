flowchart TB
  subgraph Client["Client Tier"]
    WEB["React Web Application\n(Typed OpenAPI SDK)"]
  end

  subgraph Core["Core API & Realtime Tier"]
    direction LR
    API["FastAPI Core API\n(Auth, Catalog, Orders, Governance, /ws)"]
    REDIS["Redis\n(Auth Rate Limits & Health Check)"]
    API -->|"Rate-limit counters"| REDIS
  end

  subgraph Persist["Authoritative Persistence & Async Worker Tier"]
    direction LR
    MINIO["MinIO Storage\n(Public & Private Buckets)"]
    PG["PostgreSQL 16 + pgvector\n(27 ORM Tables + matching_revision)"]
    WORKER["Matching Worker\n(SKIP LOCKED + /healthz)"]
    WORKER -->|"Claim jobs & write results"| PG
  end

  subgraph Advisory["Non-Authoritative Advisory & Display Tier"]
    direction LR
    M7M8["Frozen M7 / M8 RPC\n(Keyword, Price, Trust, Risk)"]
    SEM["Optional Live BGE\n(Semantic /score)"]
    TRANS["Local Translator\n(HY-MT1.5-1.8B :18790, Public Only)"]
  end

  WEB -->|"HTTPS JSON / Cookie / WS"| API
  WEB -.->|"Public catalog text"| TRANS
  API -->|"S3 put / get"| MINIO
  API -->|"SQL & row locks"| PG
  API -->|"HTTP RPC (1.5 s)"| M7M8
  WORKER -->|"HTTP RPC (1.5 s)"| M7M8
  API -.->|"Optional HTTP (3.0 s)"| SEM
