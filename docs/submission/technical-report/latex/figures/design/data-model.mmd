erDiagram
  users {
    bigint id PK
    varchar email UK
    varchar role
    varchar status
  }
  products {
    bigint id PK
    bigint owner_id FK
    varchar category
    numeric price
    varchar status
    boolean moderation_blocked
  }
  product_images {
    bigint id PK
    bigint product_id FK
    varchar url
    int sort_order
  }
  favorites {
    bigint id PK
    bigint user_id FK
    bigint product_id FK
  }
  wanted_posts {
    bigint id PK
    bigint owner_id FK
    varchar status
    timestamptz expires_at
  }
  chat_sessions {
    bigint id PK
    bigint product_id FK
    bigint buyer_id FK
    bigint seller_id FK
    bigint wanted_id FK
  }
  chat_messages {
    bigint id PK
    bigint session_id FK
    bigint sender_id FK
    varchar client_msg_id
  }

  users ||--o{ products : "owner_id"
  products ||--o{ product_images : "product_id"
  users ||--o{ favorites : "user_id"
  products ||--o{ favorites : "unique(user,product)"
  users ||--o{ wanted_posts : "owner_id"
  products ||--o{ chat_sessions : "product_id"
  wanted_posts |o..o{ chat_sessions : "optional wanted_id"
  users ||--o{ chat_sessions : "buyer_id / seller_id"
  chat_sessions ||--o{ chat_messages : "session_id"
  users ||--o{ chat_messages : "unique(sender,client_msg_id)"
