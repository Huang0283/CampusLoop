classDiagram
  direction TB

  class TimestampMixin {
    +created_at: datetime
    +updated_at: datetime | None
  }

  class User {
    +id: int
    +email: str
    +role: str
    +status: str
    +school: str | None
  }

  class Product {
    +id: int
    +owner_id: int
    +title: str
    +category: str
    +condition: str
    +price: Decimal
    +status: str
    +moderation_blocked: bool
  }

  class ChatSession {
    +id: int
    +product_id: int | None
    +buyer_id: int
    +seller_id: int
    +wanted_id: int | None
    +session_type: str
    +last_message_at: datetime | None
  }

  class Offer {
    +id: int
    +session_id: int
    +buyer_id: int
    +seller_id: int
    +proposer_id: int | None
    +amount: Decimal
    +status: str
    +expires_at: datetime | None
  }

  class Order {
    +id: int
    +product_id: int
    +buyer_id: int
    +seller_id: int
    +offer_id: int
    +status: str
    +buyer_confirmed_complete: bool
    +seller_confirmed_complete: bool
  }

  class Meetup {
    +id: int
    +order_id: int
    +place: str
    +confirmed_slot: datetime | None
    +version: int
    +buyer_confirmed_version: int
    +seller_confirmed_version: int
    +status: str
  }

  TimestampMixin <|-- User
  TimestampMixin <|-- Product
  TimestampMixin <|-- ChatSession
  TimestampMixin <|-- Offer
  TimestampMixin <|-- Order
  TimestampMixin <|-- Meetup

  User "1" --> "0..*" Product : owns
  Product "0..1" --> "0..*" ChatSession : scoped thread
  Product "1" --> "0..*" Order : historical trades
  ChatSession "1" --> "0..*" Offer : negotiates
  Order "0..1" <-- "1" Offer : accepted into
  Order "1" --> "0..1" Meetup : schedules
