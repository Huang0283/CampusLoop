flowchart TD
    Request["Search / wanted match / price / trust / risk request"] --> Validate["Validate contract and hard constraints"]
    Validate -->|"invalid"| Reject["4xx business error"]
    Validate -->|"valid"| Enabled{"Advisory service enabled\nand credentials valid?"}
    Enabled -->|"yes"| RPC["Call isolated service with 1.5 s timeout"]
    RPC --> Check{"Response schema, version,\nidentity and bounds valid?"}
    Check -->|"yes"| Recheck["Re-read product visibility and version"]
    Check -->|"no / timeout / 5xx"| Fallback["Use frozen local rule baseline or unavailable result"]
    Enabled -->|"no"| Fallback
    Fallback --> Mark["degraded = true and explicit reason"]
    Recheck --> Output["Return advisory output"]
    Mark --> Output
    Output --> Human{"Risk or governance decision?"}
    Human -->|"yes"| Review["Administrator reviews; no automatic enforcement"]
    Human -->|"no"| UI["Display result and disclaimer"]
